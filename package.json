{
  "name": "punchpress",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/web build",
    "build:web": "bun run --cwd apps/web build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:desktop:unsigned": "bun run --cwd apps/desktop build:unsigned",
    "preview": "bun run --cwd apps/web preview",
    "publish:desktop": "bun run --cwd apps/desktop publish",
    "release:bump": "node scripts/release/bump-version.mjs",
    "release:notes": "node scripts/release/extract-release-notes-from-changelog.mjs",
    "release:collect-changelog-context": "node scripts/release/collect-changelog-context.mjs",
    "release:check": "node scripts/release/validate-release-metadata.mjs",
    "release:check-desktop-artifacts": "node scripts/release/check-desktop-artifacts.mjs",
    "lint": "bun run --cwd apps/web lint",
    "lint:fix": "bun run --cwd apps/web lint:fix",
    "check": "bun run --cwd apps/web check",
    "fix": "bun run --cwd apps/web fix",
    "playwright:install": "playwright install chromium",
    "test:editor": "bun test apps/web/tests/editor-contract",
    "test:editor:watch": "bun test --watch apps/web/tests/editor-contract",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:performance:headed": "playwright test --config playwright.performance.config.ts --headed",
    "test:performance:benchmark": "bun scripts/performance/run-web-benchmark.ts",
    "test:performance:benchmark:headed": "bun scripts/performance/run-web-benchmark.ts --headed",
    "test:performance:trace": "PUNCHPRESS_CAPTURE_CHROME_TRACE=1 playwright test --config playwright.performance.config.ts --headed",
    "test:performance:desktop": "playwright test --config playwright.desktop-performance.config.ts",
    "test:performance:desktop:trace": "PUNCHPRESS_CAPTURE_ELECTRON_TRACE=1 playwright test --config playwright.desktop-performance.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.13",
    "@xmldom/xmldom": "0.9.10",
    "brace-expansion": "5.0.6",
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "ip-address": "10.2.0",
    "lodash": "4.18.1",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.4",
    "postcss": "8.5.14",
    "tar": "7.5.15",
    "vite": "7.3.3"
  }
}
